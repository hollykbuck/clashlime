#!/usr/bin/env bash

set -euo pipefail

service_name=clashlime-supervisor.service
systemd_user_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
user_binary="$HOME/.local/bin/clashlime"
user_service="$systemd_user_dir/$service_name"
plugin_path="$HOME/.config/omarchy/plugins/hollykbuck.clashlime"

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user disable --now "$service_name" >/dev/null 2>&1 || true
fi

if [[ -e $plugin_path || -L $plugin_path ]]; then
  if command -v omarchy >/dev/null 2>&1; then
    omarchy plugin remove hollykbuck.clashlime --yes
  else
    echo "Omarchy is unavailable; kept Shell plugin at $plugin_path." >&2
  fi
fi

# Stop the daemon (systemd handled above; pkill covers strays)
pkill -f "clashlime --daemon" 2>/dev/null || true

rm -f -- "$user_binary" "$user_service"

if command -v pacman >/dev/null 2>&1 && pacman -Qq clashlime >/dev/null 2>&1; then
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to remove the pacman-managed clashlime package." >&2
    exit 1
  fi
  sudo pacman -R --noconfirm clashlime
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user reset-failed "$service_name" >/dev/null 2>&1 || true
fi

echo "Uninstalled clashlime. Configuration and runtime data were preserved."
