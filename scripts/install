#!/usr/bin/env bash

set -euo pipefail

repository=https://github.com/ourongxing/omash
install_tag=v0.1.3
build_root=$(mktemp -d -t omash-install.XXXXXXXX)
# Non-privileged: do not require omarchy/pacman/sudo.
# Core/GeoIP will be resolved at runtime via $OMASH_MIHOMO / ~/.local/bin/mihomo / ~/.local/share/omash/bin/mihomo
# and ~/.local/share/omash/Country.mmdb. If missing, omash still starts and will report at validation time.

cleanup() {
  rm -rf -- "$build_root"
}
trap cleanup EXIT

allow_missing_core=false
core_auto_download=false
for arg in "$@"; do
  case "$arg" in
    --allow-missing-core) allow_missing_core=true ;;
    --with-core) core_auto_download=true ;;
    --help|-h)
      echo "Usage: $0 [--allow-missing-core] [--with-core]" >&2
      echo "  --allow-missing-core  skip mihomo/Country.mmdb checks (default: warn only)" >&2
      echo "  --with-core           try to download mihomo+Country.mmdb to ~/.local/share/omash (requires curl)" >&2
      exit 0
      ;;
  esac
done

# omarchy is optional now; keep warning for Omarchy-specific features
if ! command -v omarchy >/dev/null 2>&1; then
  echo "Note: omarchy not found — installing in generic (non-privileged) mode." >&2
  echo "      Omarchy theme/widget integration will be unavailable." >&2
fi

for command in curl tar install sed; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$command is required to install omash." >&2
    exit 1
  fi
done
if ! command -v cargo >/dev/null 2>&1; then
  if command -v rustc >/dev/null 2>&1; then
    echo "cargo not found but rustc is present — check PATH" >&2
  fi
  echo "cargo is required to install omash (or download a release archive)." >&2
  echo "Install it with: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh" >&2
  if command -v omarchy >/dev/null 2>&1; then
    echo "Or: omarchy install dev-env rust" >&2
  fi
  exit 1
fi

# systemd user manager is required: omash supervises mihomo via a
# systemd user unit, no fallback backend.
if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemctl is required to install omash (systemd user unit supervision)." >&2
  exit 1
fi

# Check core/geoip, but do NOT hard-fail for non-privileged users
missing_core=false
missing_geo=false
# Resolve via same logic as Rust: $OMASH_MIHOMO, ~/.local/bin/mihomo, ~/.local/share/omash/bin/mihomo, PATH, /usr/bin/mihomo
resolve_mihomo() {
  if [[ -n "${OMASH_MIHOMO:-}" && -x "${OMASH_MIHOMO}" ]]; then echo "$OMASH_MIHOMO"; return 0; fi
  if [[ -n "${OMASH_CORE_BIN:-}" && -x "${OMASH_CORE_BIN}" ]]; then echo "$OMASH_CORE_BIN"; return 0; fi
  if [[ -x "$HOME/.local/bin/mihomo" ]]; then echo "$HOME/.local/bin/mihomo"; return 0; fi
  if [[ -x "$HOME/.local/share/omash/bin/mihomo" ]]; then echo "$HOME/.local/share/omash/bin/mihomo"; return 0; fi
  if command -v mihomo >/dev/null 2>&1; then command -v mihomo; return 0; fi
  if [[ -x /usr/bin/mihomo ]]; then echo "/usr/bin/mihomo"; return 0; fi
  return 1
}
if ! resolve_mihomo >/dev/null 2>&1; then
  missing_core=true
fi
if [[ ! -f "$HOME/.local/share/omash/Country.mmdb" && ! -f "$HOME/.local/share/omash/geo/Country.mmdb" && ! -f /etc/mihomo/Country.mmdb && ! -f /etc/clash/Country.mmdb ]]; then
  missing_geo=true
fi

if [[ "$missing_core" == true || "$missing_geo" == true ]]; then
  if [[ "$core_auto_download" == true ]]; then
    echo "Attempting to download missing core/geoip to ~/.local/share/omash ..." >&2
    mkdir -p "$HOME/.local/share/omash/bin" "$HOME/.local/share/omash/geo"
    # Best-effort: try MetaCubeX mihomo latest (linux amd64). Failure is non-fatal.
    if [[ "$missing_core" == true ]]; then
      mihomo_url="https://github.com/MetaCubeX/mihomo/releases/latest/download/mihomo-linux-amd64-v1.gz"
      if curl -fsSL "$mihomo_url" -o "$build_root/mihomo.gz"; then
        gunzip -c "$build_root/mihomo.gz" > "$HOME/.local/share/omash/bin/mihomo" && chmod +x "$HOME/.local/share/omash/bin/mihomo" && echo "Downloaded mihomo to ~/.local/share/omash/bin/mihomo" >&2 && missing_core=false || echo "Failed to install mihomo binary" >&2
      else
        echo "Failed to download mihomo from $mihomo_url — please install manually or set \$OMASH_MIHOMO" >&2
      fi
    fi
    if [[ "$missing_geo" == true ]]; then
      geo_url="https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country.mmdb"
      # also try Loyalsoldier mirror
      if curl -fsSL "$geo_url" -o "$HOME/.local/share/omash/Country.mmdb"; then
        echo "Downloaded Country.mmdb to ~/.local/share/omash/Country.mmdb" >&2 && missing_geo=false
      elif curl -fsSL "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/country.mmdb" -o "$HOME/.local/share/omash/Country.mmdb"; then
        echo "Downloaded Country.mmdb (mirror) to ~/.local/share/omash/Country.mmdb" >&2 && missing_geo=false
      else
        echo "Failed to download Country.mmdb — GEOIP rules may fail until you place one at ~/.local/share/omash/Country.mmdb" >&2
      fi
    fi
  fi
  if [[ "$missing_core" == true ]]; then
    echo "Warning: mihomo not found. omash will install, but Mihomo won't start until you provide a binary." >&2
    echo "  Options: 1) install system package (if privileged): omarchy pkg aur add mihomo  OR  sudo pacman -S mihomo" >&2
    echo "           2) download to ~/.local/bin/mihomo or ~/.local/share/omash/bin/mihomo" >&2
    echo "           3) set \$OMASH_MIHOMO=/path/to/mihomo" >&2
    echo "           4) rerun with --with-core to auto-download" >&2
    if [[ "$allow_missing_core" != true ]]; then
      echo "Continuing anyway (non-privileged mode). Use --allow-missing-core to silence this." >&2
    fi
  fi
  if [[ "$missing_geo" == true ]]; then
    echo "Warning: Country.mmdb not found. GEOIP features may fail." >&2
    echo "  Place one at ~/.local/share/omash/Country.mmdb or install clash-geoip if privileged." >&2
  fi
fi

if [[ ! $install_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Invalid omash install tag: $install_tag" >&2
  exit 1
fi

archive="$build_root/$install_tag.tar.gz"
curl -fsSL "$repository/archive/refs/tags/$install_tag.tar.gz" -o "$archive"
tar -xzf "$archive" -C "$build_root"
source_root="$build_root/omash-${install_tag#v}"

cargo build --locked --release --manifest-path "$source_root/Cargo.toml"

binary_path="$HOME/.local/bin/omash"
service_path="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omash-supervisor.service"

install -Dm755 "$source_root/target/release/omash" "$binary_path"
# systemd-only autostart: the user unit is enabled on first TUI run
# (`auto_start = true` default); no XDG autostart entry.
install -Dm644 "$source_root/systemd/omash-supervisor.service" "$service_path"
sed -i 's|^ExecStart=.*|ExecStart=%h/.local/bin/omash --daemon|' "$service_path"

systemctl --user daemon-reload
# Best-effort start now (first TUI run enables autostart and finishes setup).
systemctl --user try-restart omash-supervisor.service 2>/dev/null || systemctl --user start omash-supervisor.service 2>/dev/null || echo "Could not start omash-supervisor.service now; run omash once to finish setup." >&2

echo "Installed omash $install_tag to $binary_path."
if [[ :$PATH: == *":$HOME/.local/bin:"* ]]; then
  echo "Run: omash"
else
  echo "Add \$HOME/.local/bin to PATH, then run: omash"
fi
if [[ "$missing_core" == true ]]; then
  echo "Next: provide mihomo binary and rerun, or set \$OMASH_MIHOMO — then run omash to finish setup."
fi
