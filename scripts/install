#!/usr/bin/env bash

set -euo pipefail

repository=https://github.com/hollykbuck/clashlime
install_tag=v1.2.0
build_root=$(mktemp -d -t clashlime-install.XXXXXXXX)
# Non-privileged: do not require omarchy/pacman/sudo.
# Core/GeoIP are self-managed at runtime via $CLASHLIME_MIHOMO / dialog choice / ~/.local/share/clashlime/bin/mihomo
# and ~/.local/share/clashlime/Country.mmdb. If missing, clashlime still starts and the first-run dialog offers download or a manual path.

cleanup() {
  rm -rf -- "$build_root"
}
trap cleanup EXIT

allow_missing_core=false
core_auto_download=false
for arg in "$@"; do
  case "$arg" in
    --allow-missing-core) allow_missing_core=true ;;
    --with-core) core_auto_download=true ;;
    --help|-h)
      echo "Usage: $0 [--allow-missing-core] [--with-core]" >&2
      echo "  --allow-missing-core  skip mihomo/Country.mmdb checks (default: warn only)" >&2
      echo "  --with-core           try to download mihomo+Country.mmdb to ~/.local/share/clashlime (requires curl)" >&2
      exit 0
      ;;
  esac
done

# omarchy is optional now; keep warning for Omarchy-specific features
if ! command -v omarchy >/dev/null 2>&1; then
  echo "Note: omarchy not found — installing in generic (non-privileged) mode." >&2
  echo "      Omarchy theme/widget integration will be unavailable." >&2
fi

for command in curl tar install sed; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$command is required to install clashlime." >&2
    exit 1
  fi
done
if ! command -v cargo >/dev/null 2>&1; then
  if command -v rustc >/dev/null 2>&1; then
    echo "cargo not found but rustc is present — check PATH" >&2
  fi
  echo "cargo is required to install clashlime (or download a release archive)." >&2
  echo "Install it with: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh" >&2
  if command -v omarchy >/dev/null 2>&1; then
    echo "Or: omarchy install dev-env rust" >&2
  fi
  exit 1
fi

# systemd user manager is required: clashlime supervises mihomo via a
# systemd user unit, no fallback backend.
if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemctl is required to install clashlime (systemd user unit supervision)." >&2
  exit 1
fi

# Check core/geoip, but do NOT hard-fail for non-privileged users
missing_core=false
missing_geo=false
# Install-time presence check (superset of the runtime resolution, which is
# self-managed only: $CLASHLIME_MIHOMO, dialog choice, ~/.local/share/clashlime/bin/mihomo)
resolve_mihomo() {
  if [[ -n "${CLASHLIME_MIHOMO:-}" && -x "${CLASHLIME_MIHOMO}" ]]; then echo "$CLASHLIME_MIHOMO"; return 0; fi
  if [[ -n "${CLASHLIME_CORE_BIN:-}" && -x "${CLASHLIME_CORE_BIN}" ]]; then echo "$CLASHLIME_CORE_BIN"; return 0; fi
  if [[ -x "$HOME/.local/bin/mihomo" ]]; then echo "$HOME/.local/bin/mihomo"; return 0; fi
  if [[ -x "$HOME/.local/share/clashlime/bin/mihomo" ]]; then echo "$HOME/.local/share/clashlime/bin/mihomo"; return 0; fi
  if command -v mihomo >/dev/null 2>&1; then command -v mihomo; return 0; fi
  if [[ -x /usr/bin/mihomo ]]; then echo "/usr/bin/mihomo"; return 0; fi
  return 1
}
if ! resolve_mihomo >/dev/null 2>&1; then
  missing_core=true
fi
if [[ ! -f "$HOME/.local/share/clashlime/Country.mmdb" && ! -f "$HOME/.local/share/clashlime/geo/Country.mmdb" && ! -f /etc/mihomo/Country.mmdb && ! -f /etc/clash/Country.mmdb ]]; then
  missing_geo=true
fi

if [[ "$missing_core" == true || "$missing_geo" == true ]]; then
  if [[ "$core_auto_download" == true ]]; then
    echo "Attempting to download missing core/geoip to ~/.local/share/clashlime ..." >&2
    mkdir -p "$HOME/.local/share/clashlime/bin" "$HOME/.local/share/clashlime/geo"
    # Best-effort: try MetaCubeX mihomo latest (linux amd64). Failure is non-fatal.
    if [[ "$missing_core" == true ]]; then
      mihomo_url="https://github.com/MetaCubeX/mihomo/releases/latest/download/mihomo-linux-amd64-v1.gz"
      if curl -fsSL "$mihomo_url" -o "$build_root/mihomo.gz"; then
        gunzip -c "$build_root/mihomo.gz" > "$HOME/.local/share/clashlime/bin/mihomo" && chmod +x "$HOME/.local/share/clashlime/bin/mihomo" && echo "Downloaded mihomo to ~/.local/share/clashlime/bin/mihomo" >&2 && missing_core=false || echo "Failed to install mihomo binary" >&2
      else
        echo "Failed to download mihomo from $mihomo_url — please install manually or set \$CLASHLIME_MIHOMO" >&2
      fi
    fi
    if [[ "$missing_geo" == true ]]; then
      geo_url="https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country.mmdb"
      # also try Loyalsoldier mirror
      if curl -fsSL "$geo_url" -o "$HOME/.local/share/clashlime/Country.mmdb"; then
        echo "Downloaded Country.mmdb to ~/.local/share/clashlime/Country.mmdb" >&2 && missing_geo=false
      elif curl -fsSL "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/country.mmdb" -o "$HOME/.local/share/clashlime/Country.mmdb"; then
        echo "Downloaded Country.mmdb (mirror) to ~/.local/share/clashlime/Country.mmdb" >&2 && missing_geo=false
      else
        echo "Failed to download Country.mmdb — GEOIP rules may fail until you place one at ~/.local/share/clashlime/Country.mmdb" >&2
      fi
    fi
  fi
  if [[ "$missing_core" == true ]]; then
    echo "Warning: mihomo not found. clashlime will install; on first TUI launch pick Download or point at an existing binary." >&2
    echo "  Options: 1) TUI core dialog: download a release (self-managed) or use an existing binary incl. system mihomo" >&2
    echo "           2) set \$CLASHLIME_MIHOMO=/path/to/mihomo" >&2
    echo "           3) rerun with --with-core to auto-download" >&2
    if [[ "$allow_missing_core" != true ]]; then
      echo "Continuing anyway (non-privileged mode). Use --allow-missing-core to silence this." >&2
    fi
  fi
  if [[ "$missing_geo" == true ]]; then
    echo "Warning: Country.mmdb not found. GEOIP features may fail." >&2
    echo "  Place one at ~/.local/share/clashlime/Country.mmdb or install clash-geoip if privileged." >&2
  fi
fi

if [[ ! $install_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Invalid clashlime install tag: $install_tag" >&2
  exit 1
fi

archive="$build_root/$install_tag.tar.gz"
curl -fsSL "$repository/archive/refs/tags/$install_tag.tar.gz" -o "$archive"
tar -xzf "$archive" -C "$build_root"
source_root="$build_root/clashlime-${install_tag#v}"

cargo build --locked --release --manifest-path "$source_root/Cargo.toml"

binary_path="$HOME/.local/bin/clashlime"
service_path="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/clashlime-supervisor.service"

install -Dm755 "$source_root/target/release/clashlime" "$binary_path"
# systemd-only autostart: the user unit is enabled on first TUI run
# (`auto_start = true` default); no XDG autostart entry.
install -Dm644 "$source_root/systemd/clashlime-supervisor.service" "$service_path"
sed -i 's|^ExecStart=.*|ExecStart=%h/.local/bin/clashlime --daemon|' "$service_path"

systemctl --user daemon-reload
# Best-effort start now (first TUI run enables autostart and finishes setup).
systemctl --user try-restart clashlime-supervisor.service 2>/dev/null || systemctl --user start clashlime-supervisor.service 2>/dev/null || echo "Could not start clashlime-supervisor.service now; run clashlime once to finish setup." >&2

echo "Installed clashlime $install_tag to $binary_path."
if [[ :$PATH: == *":$HOME/.local/bin:"* ]]; then
  echo "Run: clashlime"
else
  echo "Add \$HOME/.local/bin to PATH, then run: clashlime"
fi
if [[ "$missing_core" == true ]]; then
  echo "Next: provide mihomo binary and rerun, or set \$CLASHLIME_MIHOMO — then run clashlime to finish setup."
fi
