[Unit]
Description=Clashlime Mihomo Supervisor (System Service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/clashlime --system --daemon
Restart=on-failure
RestartSec=2
Group=clashlime
RuntimeDirectory=clashlime
RuntimeDirectoryMode=0750
StateDirectory=clashlime
StateDirectoryMode=0750
ConfigurationDirectory=clashlime
ConfigurationDirectoryMode=0750
LogsDirectory=clashlime
LogsDirectoryMode=0755

# Ambient capabilities for TUN mode without running as root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
